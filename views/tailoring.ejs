<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="profile-page tailoring-page">
  <section class="profile-hero">
    <div class="container profile-hero-inner">
      <div class="profile-media reveal">
        <img src="<%= profile.photo %>" alt="<%= profile.name %>" />
      </div>
      <div class="profile-copy reveal">
        <p class="eyebrow">Tailoring & fashion</p>
        <h1><%= profile.name %></h1>
        <h2><%= profile.title %></h2>
        <p class="lead"><%= profile.bio %></p>
        <ul class="meta-list">
          <li><strong>Location:</strong> <%= profile.location %></li>
          <li><strong>Availability:</strong> <%= profile.availability %></li>
          <li><strong>Experience:</strong> <%= profile.experience_years %></li>
          <li><strong>Arrangement:</strong> <%= profile.employment_type %></li>
        </ul>
        <div class="cta-row">
          <a class="btn btn-primary" href="tel:<%= profile.phone || '0721909801' %>">Call Tailor</a>
          <a class="btn btn-secondary" href="sms:<%= profile.phone || '0721909801' %>">Send SMS</a>
          <a class="btn btn-secondary" href="<%= whatsappLink %>" target="_blank" rel="noreferrer">WhatsApp</a>
          <a class="btn btn-secondary" href="mailto:<%= profile.email || 'hello@craftandcurrent.co.ke' %>">Email</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section profile-section">
    <div class="container two-column-layout">
      <div class="content-block reveal">
        <p class="eyebrow">Services</p>
        <h3>Tailoring services</h3>
        <ul class="content-list">
          <% services.forEach((service) => { %>
            <li>
              <strong><%= service.title %></strong>
              <p><%= service.description %></p>
            </li>
          <% }) %>
        </ul>
      </div>
      <div class="content-block reveal">
        <p class="eyebrow">Business profile</p>
        <h3>Fashion and garment focus</h3>
        <p><%= profile.overview %></p>
        <p>Custom orders, repairs and alterations are managed with a focus on fit, fabric handling and garment longevity.</p>
      </div>
    </div>
  </section>

  <section class="section profile-section alt-panel">
    <div class="container">
      <div class="section-heading reveal">
        <p class="eyebrow">Portfolio</p>
        <h2>Garment highlights and recent work</h2>
      </div>
      <div class="project-grid">
        <% projects.forEach((project) => { %>
          <article class="project-card reveal">
            <div class="project-image" style="background-image: url('<%= project.image %>');"></div>
            <div class="project-copy">
              <span class="panel-tag"><%= project.category %></span>
              <h3><%= project.title %></h3>
              <p><%= project.description %></p>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <section id="contact" class="section contact-section">
    <div class="container contact-grid">
      <div class="contact-card reveal">
        <p class="eyebrow">Enquiries</p>
        <h2>Request a quote for garments, repairs or alterations</h2>
        <ul class="contact-list">
          <li><a href="tel:<%= profile.phone || '0721909801' %>">Phone</a></li>
          <li><a href="sms:<%= profile.phone || '0721909801' %>">SMS</a></li>
          <li><a href="<%= whatsappLink %>" target="_blank" rel="noreferrer">WhatsApp</a></li>
          <li><a href="mailto:<%= profile.email || 'hello@craftandcurrent.co.ke' %>">Email</a></li>
        </ul>
      </div>

      <form class="enquiry-form reveal" method="POST" action="/enquiry">
        <input type="hidden" name="role" value="tailor" />
        <label>
          <span>Customer name</span>
          <input type="text" name="customer_name" required />
        </label>
        <label>
          <span>Garment or service required</span>
          <input type="text" name="subject" required />
        </label>
        <label>
          <span>Project details</span>
          <textarea name="message" rows="5" required></textarea>
        </label>
        <div class="field-grid">
          <label>
            <span>Preferred date</span>
            <input type="date" name="date" />
          </label>
          <label>
            <span>Budget range</span>
            <input type="text" name="budget" />
          </label>
        </div>
        <button class="btn btn-primary" type="submit">Send enquiry</button>
      </form>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
