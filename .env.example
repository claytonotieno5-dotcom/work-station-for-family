# Copy to .env for local development. Replace every placeholder locally.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Authentication: all three role passwords are required in production.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ELECTRICIAN_PASSWORD=replace-locally
TAILOR_PASSWORD=replace-locally
DEVELOPER_PASSWORD=replace-locally
TRUST_PROXY=false

# Local development uses JSON data and local uploads by default.
DATA_DIR=./data
UPLOAD_DIR=./uploads
STORAGE_PROVIDER=local

# Production requires Neon PostgreSQL and the role credentials above.
# Vercel Blob uses managed OIDC credentials when the store is connected to the
# project, or BLOB_READ_WRITE_TOKEN as a fallback. STORAGE_PROVIDER defaults
# to blob on Vercel and local elsewhere.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
